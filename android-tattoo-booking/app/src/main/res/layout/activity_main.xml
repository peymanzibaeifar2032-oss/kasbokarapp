<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0B0C"
    android:orientation="vertical">

    <ScrollView
        android:id="@+id/ownerChrome"
        android:layout_width="match_parent"
        android:layout_height="292dp"
        android:background="#111113"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="6dp"
                android:text="منوی استودیو"
                android:textColor="#B7955B"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/menuHome"
                style="@style/StudioMenuItem"
                android:text="صفحه استودیو" />

            <TextView
                android:id="@+id/menuRequest"
                style="@style/StudioMenuItem"
                android:text="درخواست نوبت" />

            <TextView
                android:id="@+id/menuStatus"
                style="@style/StudioMenuItem"
                android:text="وضعیت نوبت" />

            <TextView
                android:id="@+id/menuDesigns"
                style="@style/StudioMenuItem"
                android:text="انتخاب طرح" />

            <TextView
                android:id="@+id/menuGuide"
                style="@style/StudioMenuItem"
                android:text="آموزش و مراقبت" />

            <TextView
                android:id="@+id/adminBar"
                style="@style/StudioMenuItem"
                android:text="پنل ادمین · در مرورگر" />

            <TextView
                android:id="@+id/loginBar"
                style="@style/StudioMenuItem"
                android:text="ورود" />

            <TextView
                android:id="@+id/logoutBar"
                style="@style/StudioMenuItem"
                android:text="خروج" />
        </LinearLayout>
    </ScrollView>

    <WebView
        android:id="@+id/web"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:importantForAutofill="yes" />
</LinearLayout>
