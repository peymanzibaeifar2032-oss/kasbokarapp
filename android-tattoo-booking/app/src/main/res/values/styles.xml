<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:statusBarColor">#0B0B0C</item>
        <item name="android:navigationBarColor">#0B0B0C</item>
        <item name="android:windowBackground">#0B0B0C</item>
        <item name="android:colorPrimary">#B7955B</item>
    </style>

    <style name="StudioMenuItem">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:background">#1C1C20</item>
        <item name="android:gravity">center_vertical|right</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textColor">#F4F1EA</item>
        <item name="android:textSize">15sp</item>
    </style>
</resources>
