# Independent production for kasbokarapp.com
# Copy to .env on the server. Never commit real values.

STANDALONE=true
NODE_ENV=production

# Public origin (no trailing slash)
SITE_URL=https://kasbokarapp.com
BETTER_AUTH_URL=https://kasbokarapp.com

# Postgres (Neon / Liara / Pars Pack / Docker). Required. No in-memory fallback.
DATABASE_URL=postgres://USER:PASSWORD@HOST/kasbokar?sslmode=require

# Session signing key — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=

# Optional: password-reset and critical bug email (Resend)
RESEND_API_KEY=
AUTH_FROM_EMAIL=کسب‌وکار <noreply@kasbokarapp.com>
BUG_NOTIFY_EMAIL=
BUG_NOTIFY_FROM_EMAIL=کسب‌وکار <noreply@kasbokarapp.com>
BUG_NOTIFY_WEBHOOK_URL=
BUG_NOTIFY_TELEGRAM_CHAT_ID=

# Optional: in-app guide model. Leave empty to use the built-in FAQ fallback.
XAI_API_KEY=

# Docker / VPS only
NITRO_PRESET=node-server
PORT=8080
