# Independent production for kasbokarapp.com
# Copy to .env on the server. Never commit real values.

STANDALONE=true
NODE_ENV=production

# Public origin (no trailing slash)
SITE_URL=https://kasbokarapp.com
BETTER_AUTH_URL=https://kasbokarapp.com
TRUSTED_ORIGINS=

# Postgres. Same app talks to Netlify/Neon today or Postgres on the VPS later.
# sslmode=require for hosted; for Docker Compose --profile with-db use the internal URL.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/kasbokar?sslmode=require

# Session signing key — generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=

# Optional: password-reset mail. Prefer SMTP on an Iranian VPS (Resend may be unreachable).
RESEND_API_KEY=
AUTH_FROM_EMAIL="کسب‌وکار <noreply@kasbokarapp.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="کسب‌وکار <noreply@kasbokarapp.com>"

# Optional: in-app guide model. Leave empty to use the built-in FAQ (works offline/in Iran).
XAI_API_KEY=

# Optional bug alerts
BUG_NOTIFY_EMAIL=
BUG_NOTIFY_FROM_EMAIL="کسب‌وکار <noreply@kasbokarapp.com>"
BUG_NOTIFY_WEBHOOK_URL=
BUG_NOTIFY_TELEGRAM_CHAT_ID=

# Map tiles — coordinates stay in our DB. Do not use public OSM.org in Iran production.
# Option A: Iranian provider (Neshan / Map.ir) Leaflet XYZ template:
# MAP_TILE_URL=https://YOUR_IRAN_TILES/{z}/{x}/{y}.png
# MAP_TILE_ATTRIBUTION=© Map.ir
# Option B: same-origin proxy (browser talks only to kasbokarapp.com):
# MAP_TILE_PROXY_UPSTREAM=https://YOUR_UPSTREAM/{z}/{x}/{y}.png
# MAP_TILE_PROXY_KEY=
# MAP_TILE_PROXY_KEY_HEADER=x-api-key
# Option C: self-hosted tileserver-gl on the VPS later (no app rewrite):
# MAP_TILE_URL=http://tiles:8080/styles/iran/{z}/{x}/{y}.png
MAP_TILE_URL=
MAP_TILE_URL_FALLBACK=
MAP_TILE_ATTRIBUTION=
MAP_TILE_MAX_ZOOM=19
MAP_TILE_SUBDOMAINS=
MAP_TILE_PROXY_UPSTREAM=
MAP_TILE_PROXY_KEY=
MAP_TILE_PROXY_KEY_HEADER=

# Docker / VPS
NITRO_PRESET=node-server
PORT=8080
APP_PORT=8080
POSTGRES_PASSWORD=
SITE_HOST=kasbokarapp.com
CADDY_EMAIL=ops@kasbokarapp.com
# with-db = Postgres in Compose; tls = Caddy HTTPS. Leave empty to attach an existing DATABASE_URL only.
COMPOSE_PROFILES=with-db,tls
