# File-based TLS from CSR-split DNS-01. auto_https is off on purpose:
# Let's Encrypt HTTP-01 from Iran is unreliable, and Caddy reload does not
# re-read replaced PEM files (container recreate is required).
# Renew before notAfter with deploy/tls-activate-next.sh; keys stay on the VPS.
{
  email {$CADDY_EMAIL}
  auto_https off
}

http://185.204.197.211 {
  encode gzip zstd
  reverse_proxy web:8080
  header {
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    X-Frame-Options "SAMEORIGIN"
    Permissions-Policy "camera=(), microphone=(), payment=(), geolocation=(self)"
  }
  @cached path /api/tiles/* /assets/* *.js *.css *.woff2 *.png *.svg *.jpg
  header @cached Cache-Control "public, max-age=86400"
  @html not path /api/tiles/* /assets/* *.js *.css *.woff2 *.png *.svg *.jpg
  header @html Cache-Control "no-store"
}

http://{$SITE_HOST}, http://www.{$SITE_HOST} {
  redir https://{$SITE_HOST}{uri} permanent
}

{$SITE_HOST}:443, www.{$SITE_HOST}:443 {
  tls /certs/fullchain.pem /certs/privkey.pem
  encode gzip zstd
  reverse_proxy web:8080
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    X-Frame-Options "SAMEORIGIN"
    Permissions-Policy "camera=(), microphone=(), payment=(), geolocation=(self)"
  }
  @cached path /api/tiles/* /assets/* *.js *.css *.woff2 *.png *.svg *.jpg
  header @cached Cache-Control "public, max-age=86400"
  @html not path /api/tiles/* /assets/* *.js *.css *.woff2 *.png *.svg *.jpg
  header @html Cache-Control "no-store"
}
