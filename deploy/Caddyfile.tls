# File-based TLS. Certs come from DNS-01 (Let's Encrypt cannot HTTP-01
# an Iran-access VPS). HTTP IP stays up. Domain HTTP redirects to HTTPS.
{
  email {$CADDY_EMAIL}
  auto_https off
}

http://185.204.197.211 {
  encode gzip zstd
  reverse_proxy web:8080
  header {
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    X-Frame-Options "SAMEORIGIN"
    Permissions-Policy "camera=(), microphone=(), payment=(), geolocation=(self)"
    Cache-Control "no-store"
  }
}

http://{$SITE_HOST}, http://www.{$SITE_HOST} {
  redir https://{$SITE_HOST}{uri} permanent
}

{$SITE_HOST}:443, www.{$SITE_HOST}:443 {
  tls /certs/fullchain.pem /certs/privkey.pem
  encode gzip zstd
  reverse_proxy web:8080
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    X-Frame-Options "SAMEORIGIN"
    Permissions-Policy "camera=(), microphone=(), payment=(), geolocation=(self)"
    Cache-Control "no-store"
  }
}
