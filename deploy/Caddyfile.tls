# Automatic HTTPS for the domain. Do NOT also bind http://kasbokarapp.com
# to reverse_proxy — that steals /.well-known/acme-challenge and certs never issue.
# Raw IP stays HTTP so http://185.204.197.211 keeps working during cutover.
{
  email {$CADDY_EMAIL}
}

{$SITE_HOST}, www.{$SITE_HOST} {
  encode gzip zstd
  reverse_proxy web:8080
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    X-Frame-Options "SAMEORIGIN"
    Permissions-Policy "camera=(), microphone=(), payment=(), geolocation=(self)"
    Cache-Control "no-store"
  }
}

http://185.204.197.211 {
  encode gzip zstd
  reverse_proxy web:8080
  header {
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    X-Frame-Options "SAMEORIGIN"
    Permissions-Policy "camera=(), microphone=(), payment=(), geolocation=(self)"
    Cache-Control "no-store"
  }
}
