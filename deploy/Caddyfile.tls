# Automatic HTTPS after A records for kasbokarapp.com and www point at this VPS.
# Keep raw IP on HTTP so the current origin still works during cutover.
{
  email {$CADDY_EMAIL}
}

www.{$SITE_HOST} {
  redir https://{$SITE_HOST}{uri} permanent
}

{$SITE_HOST} {
  encode gzip zstd
  reverse_proxy web:8080
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    X-Frame-Options "SAMEORIGIN"
    Permissions-Policy "camera=(), microphone=(), payment=(), geolocation=(self)"
  }
}

http://185.204.197.211 {
  encode gzip zstd
  reverse_proxy web:8080
  header {
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    X-Frame-Options "SAMEORIGIN"
    Permissions-Policy "camera=(), microphone=(), payment=(), geolocation=(self)"
  }
}
