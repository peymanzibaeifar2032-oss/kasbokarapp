# HTTP-only until a public certificate can be issued.
# Let's Encrypt API is often blocked from Iranian VPS networks.
{
  auto_https off
  admin off
}

:80 {
  encode gzip zstd
  handle /.well-known/acme-challenge/* {
    root * /acme-www
    file_server
  }
  reverse_proxy web:8080
  header {
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    X-Frame-Options "SAMEORIGIN"
    Permissions-Policy "camera=(), microphone=(), payment=(), geolocation=(self)"
  }
  @cached path /api/tiles/* /assets/* *.js *.css *.woff2 *.png *.svg *.jpg
  header @cached Cache-Control "public, max-age=86400"
  @html not path /api/tiles/* /assets/* *.js *.css *.woff2 *.png *.svg *.jpg
  header @html Cache-Control "no-store"
}
