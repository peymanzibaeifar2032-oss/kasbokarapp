# HTTP reverse proxy for the VPS IP. Does not request Let's Encrypt.
# Switch CADDYFILE=Caddyfile.tls in .env only after DNS A records point here.
{
  auto_https off
  admin off
}

:80 {
  encode gzip zstd
  reverse_proxy web:8080
  header {
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    X-Frame-Options "SAMEORIGIN"
    Permissions-Policy "camera=(), microphone=(), payment=()"
  }
}
